<mjml>
  <mj-head>
    <mj-title>Your data export is ready</mj-title>
    <mj-preview>MyFavApp — Your personal data archive is ready to download</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="15px" color="#555555" line-height="1.6" />
      <mj-section padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f0f2f5">

    <!-- Top accent bar -->
    <mj-section background-color="#27ae60" padding="6px 0" />

    <!-- Header -->
    <mj-section background-color="#27ae60" padding="35px 40px 30px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="26px" font-weight="bold" padding-bottom="8px">
          ✅ Your archive is ready
        </mj-text>
        <mj-text align="center" color="#d5f5e3" font-size="14px" padding-top="0">
          MyFavApp – GDPR / Right to Portability
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Greeting -->
    <mj-section background-color="#ffffff" padding="35px 40px 20px">
      <mj-column>
        <mj-text font-size="17px" color="#2c3e50" font-weight="bold" padding-bottom="4px">
          Hello <span th:text="${username}">User</span>,
        </mj-text>
        <mj-text padding-top="8px">
          Your personal data export is ready. Click the button below to download
          your archive. It contains all data we hold about your account in JSON format.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Button -->
    <mj-section background-color="#ffffff" padding="10px 40px 30px">
      <mj-column>
        <mj-text align="center" padding="20px">
          <a th:href="${downloadUrl}" style="background-color:#27ae60; color:#ffffff; padding:14px 28px;
             text-decoration:none; border-radius:6px; font-weight:bold;
             display:inline-block;">
            Download my data
          </a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Expiry info -->
    <mj-section background-color="#ffffff" padding="0 40px 20px">
      <mj-column background-color="#eafaf1" border-left="4px solid #27ae60"
                 border-radius="4px" padding="16px 20px">
        <mj-text font-size="14px" color="#1e8449">
          ⏱️ This link is valid for <strong th:text="${ttlHours}">72</strong> hours
          and can only be used <strong>once</strong>.
          After download, the archive is permanently deleted from our servers.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Security notice -->
    <mj-section background-color="#ffffff" padding="0 40px 35px">
      <mj-column background-color="#fdf2e9" border-left="4px solid #e67e22"
                 border-radius="4px" padding="16px 20px">
        <mj-text font-size="14px" color="#d35400">
          🔒 This link is personal and single-use. Do not share it with anyone.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f8f9fa" padding="25px 40px">
      <mj-column>
        <mj-text align="center" color="#6c757d" font-size="13px">
          This is an automated message — please do not reply.<br/>
          © MyFavApp. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>