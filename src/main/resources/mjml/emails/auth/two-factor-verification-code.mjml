<mjml>
  <mj-head>
    <mj-title>Code de vérification</mj-title>
    <mj-preview>Votre code de connexion 2FA</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="#555555" line-height="1.6" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f4f4">

    <!-- Header -->
    <mj-section background-color="#28a745" padding="30px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="28px" font-weight="bold">
          🔑 Code de vérification
        </mj-text>
        <mj-text align="center" color="#e0e0e0" font-size="14px">
          Connectez-vous en toute sécurité
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section background-color="#ffffff" padding="40px 30px">
      <mj-column>

        <mj-text font-size="18px" color="#333333">
          Bonjour <span th:text="${userName}">Utilisateur</span>,
        </mj-text>

        <mj-text>
          Voici votre code de vérification pour vous connecter :
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- Verification Code Box -->
    <mj-section background-color="#ffffff" padding="0 30px">
      <mj-column background-color="#f8f9fa" border-radius="8px" padding="25px">
        <mj-text align="center" font-size="12px" color="#6c757d"
                 text-transform="uppercase" letter-spacing="1px">
          Code de vérification
        </mj-text>
        <mj-text align="center" font-size="42px" font-weight="bold"
                 color="#28a745" letter-spacing="8px" font-family="Courier New, monospace">
          <span th:text="${verificationCode}">123456</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Expiration Warning -->
    <mj-section background-color="#ffffff" padding="20px 30px">
      <mj-column background-color="#fff3cd" border-radius="6px" padding="15px">
        <mj-text align="center" color="#856404" font-weight="600">
          ⏰ Ce code expire le <span th:text="${expirationTime}">11/12/2024 à 15:30</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Security Notice -->
    <mj-section background-color="#ffffff" padding="20px 30px 40px">
      <mj-column background-color="#f8d7da" border-radius="6px" padding="20px">
        <mj-text color="#721c24" font-weight="600" font-size="16px">
          ⚠️ Important
        </mj-text>
        <mj-text color="#721c24" font-size="14px">
          Si vous n'êtes pas à l'origine de cette demande, ignorez cet email.
          Ne partagez jamais ce code avec qui que ce soit.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f8f9fa" padding="30px">
      <mj-column>
        <mj-text align="center" color="#6c757d" font-size="12px">
          Cet email a été envoyé automatiquement, merci de ne pas y répondre.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>