<mjml>
  <mj-head>
    <mj-title>Confirm Your MyFavApp Account</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="15px" color="#333333" line-height="1.6" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f4f4">

    <!-- Header -->
    <mj-section background-color="#2c3e50" padding="30px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="22px" font-weight="bold">
          MyFavApp – Confirm Your Account
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Greeting -->
    <mj-section background-color="#ffffff" padding="30px 40px 10px">
      <mj-column>
        <mj-text>
          Hello <strong th:text="${username}">User</strong>,
        </mj-text>
        <mj-text>
          Thank you for signing up on <strong>MyFavApp</strong>!<br/>
          To activate your account and complete your registration, please click the button below.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Button -->
    <mj-section background-color="#ffffff" padding="10px 40px">
      <mj-column>
        <mj-button background-color="#3498db"
                   color="#ffffff"
                   font-size="16px"
                   font-weight="bold"
                   border-radius="5px"
                   padding="14px 30px"
                   href="#"
                   th:href="${url}">
          ✅ Confirm My Account
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Temporary Password Box -->
    <mj-section background-color="#ffffff" padding="10px 40px">
      <mj-column>
        <mj-text>
          For your first login, you will need to use the following credentials:
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#fff3cd" border-radius="8px" padding="5px 40px">
      <mj-column background-color="#fff3cd" border-radius="8px" padding="20px" border="2px solid #ffc107">
        <mj-text align="center" color="#856404" font-size="14px" font-weight="600">
          🔑 Temporary Password
        </mj-text>
        <mj-text align="center"
                 font-family="'Courier New', monospace"
                 font-size="22px"
                 font-weight="bold"
                 color="#333333"
                 letter-spacing="3px">
          <span th:text="${temporaryPassword}">Hl\p>tA4</span>
        </mj-text>
        <mj-text align="center" color="#856404" font-size="13px">
          ⚠️ You will be required to change this password immediately after your first login.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Steps -->
    <mj-section background-color="#e7f3ff" padding="5px 40px">
      <mj-column background-color="#e7f3ff" border-left="4px solid #2196f3" border-radius="4px" padding="20px">
        <mj-text color="#1976d2" font-weight="bold" font-size="16px">
          Getting Started – Follow These Steps:
        </mj-text>
        <mj-text color="#1976d2" font-size="14px">
          1. Click the button above to confirm your account<br/>
          2. Enter your email and the temporary password<br/>
          3. You'll be prompted to create a new secure password<br/>
          4. Once done, you can start using the platform!
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Ignore notice -->
    <mj-section background-color="#ffffff" padding="10px 40px 30px">
      <mj-column>
        <mj-text color="#777777" font-size="14px">
          If you did not request this registration, please ignore this email.
        </mj-text>
        <mj-text color="#777777" font-size="14px">
          Best regards,<br/>
          <strong>The MyFavApp Team</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f8f9fa" padding="20px 40px">
      <mj-column>
        <mj-text align="center" color="#999999" font-size="12px">
          This is an automated message. Please do not reply to this email.<br/>
          © <span th:text="${#dates.year(#dates.createNow())}">2025</span> MyFavApp. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>