<mjml>
  <mj-head>
    <mj-title>Email Change Request – MyFavApp</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="15px" color="#333333" line-height="1.6" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f4f4">

    <!-- Header -->
    <mj-section background-color="#2c3e50" padding="30px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="22px" font-weight="bold">
          🔐 Email Change Request
        </mj-text>
        <mj-text align="center" color="#bdc3c7" font-size="14px">
          MyFavApp Security Team
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Greeting -->
    <mj-section background-color="#ffffff" padding="30px 40px 10px">
      <mj-column>
        <mj-text>
          Hello <strong th:text="${username}">User</strong>,
        </mj-text>
        <mj-text>
          A request to change your email address was made on your account.
          If you initiated this request, please confirm it by clicking the button below.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Confirm CTA -->
    <mj-section background-color="#ffffff" padding="10px 40px 5px">
      <mj-column>
        <mj-button background-color="#3498db"
                   color="#ffffff"
                   font-size="15px"
                   font-weight="bold"
                   border-radius="5px"
                   padding="14px 30px"
                   href="#"
                   th:href="${oldEmailConfirmationUrl}">
          ✅ Confirm Email Change
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section background-color="#ffffff" padding="0 40px">
      <mj-column>
        <mj-divider border-color="#eeeeee" border-width="1px" />
      </mj-column>
    </mj-section>

    <!-- Security notice + Cancel CTA -->
    <mj-section background-color="#fff5f5" padding="5px 40px">
      <mj-column background-color="#fff5f5" border-radius="6px" padding="20px" border-left="4px solid #e74c3c">
        <mj-text color="#c0392b" font-weight="bold" font-size="15px">
          ❗ Didn't request this change?
        </mj-text>
        <mj-text color="#c0392b" font-size="14px">
          If you did not initiate this request, cancel it immediately to keep your account safe.
        </mj-text>
        <mj-button background-color="#e74c3c"
                   color="#ffffff"
                   font-size="15px"
                   font-weight="bold"
                   border-radius="5px"
                   padding="12px 28px"
                   href="#"
                   th:href="${cancelChangeUrl}">
          ❌ Cancel Change Request
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Expiry info -->
    <mj-section background-color="#ffffff" padding="20px 40px 30px">
      <mj-column>
        <mj-text color="#777777" font-size="13px">
          🕐 For security reasons, this link will expire in <strong>24 hours</strong>.<br/>
          If you have any questions, contact our support team at
          <a href="mailto:support@myfavapp.com" style="color:#3498db;">support@myfavapp.com</a>.
        </mj-text>
        <mj-text color="#777777" font-size="14px">
          Best regards,<br/>
          <strong>The MyFavApp Security Team</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f8f9fa" padding="20px 40px">
      <mj-column>
        <mj-text align="center" color="#999999" font-size="12px">
          This is an automated security email. Please do not reply.<br/>
          © <span th:text="${#dates.year(#dates.createNow())}">2025</span> MyFavApp. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>