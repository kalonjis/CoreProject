<mjml>
  <mj-head>
    <mj-title>Password Successfully Changed – MyFavApp</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="15px" color="#333333" line-height="1.6" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f4f4">

    <!-- Header -->
    <mj-section background-color="#2c3e50" padding="30px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="22px" font-weight="bold">
          🔒 Password Successfully Changed
        </mj-text>
        <mj-text align="center" color="#bdc3c7" font-size="14px">
          MyFavApp Security Notification
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Greeting -->
    <mj-section background-color="#ffffff" padding="30px 40px 10px">
      <mj-column>
        <mj-text>
          Hello <strong th:text="${username}">User</strong>,
        </mj-text>
        <mj-text>
          We're reaching out to confirm that your password has been <strong>successfully updated</strong>.
          If you initiated this change, no further action is required. ✅
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Success banner -->
    <mj-section background-color="#e8f5e9" padding="5px 40px">
      <mj-column background-color="#e8f5e9" border-radius="6px" padding="20px" border-left="4px solid #27ae60">
        <mj-text color="#1e8449" font-weight="bold" font-size="15px">
          ✅ Your password has been updated successfully.
        </mj-text>
        <mj-text color="#1e8449" font-size="14px">
          Your account is secure. You can now log in with your new password.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Security warning -->
    <mj-section background-color="#fff5f5" padding="5px 40px">
      <mj-column background-color="#fff5f5" border-radius="6px" padding="20px" border-left="4px solid #e74c3c">
        <mj-text color="#c0392b" font-weight="bold" font-size="15px">
          ❗ Didn't request this change?
        </mj-text>
        <mj-text color="#c0392b" font-size="14px">
          If you did not make this change, please take action immediately:<br/><br/>
          🔹 Review your account security settings<br/>
          🔹 Reset your password right away<br/>
          🔹 Enable two-factor authentication if not already active<br/>
          🔹 Contact our support team if you suspect unauthorized access
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Closing -->
    <mj-section background-color="#ffffff" padding="20px 40px 30px">
      <mj-column>
        <mj-text color="#555555" font-size="14px">
          If you need any assistance, contact us at
          <a href="mailto:support@myfavapp.com" style="color:#3498db;">support@myfavapp.com</a>.<br/><br/>
          Your security is our priority! 🔐
        </mj-text>
        <mj-text color="#777777" font-size="14px">
          Best regards,<br/>
          <strong>The MyFavApp Support Team</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f8f9fa" padding="20px 40px">
      <mj-column>
        <mj-text align="center" color="#999999" font-size="12px">
          This is an automated security notification. Please do not reply.<br/>
          © <span th:text="${#dates.year(#dates.createNow())}">2025</span> MyFavApp. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>